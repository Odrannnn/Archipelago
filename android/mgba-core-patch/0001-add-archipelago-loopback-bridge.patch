+static struct APBridge apBridge;
+static bool apBridgeReady = false;
+static unsigned apBridgeRetryFrames = 0;
+
+#define AP_BRIDGE_RETRY_INTERVAL_FRAMES 60
+
+static void _pollAPBridge(void) {
+	char messageText[AP_MGBA_MESSAGE_MAX];
+	if (!core) {
+		return;
+	}
+	if (!apBridgeReady) {
+		if (apBridgeRetryFrames) {
+			--apBridgeRetryFrames;
+			return;
+		}
+		apBridgeReady = APBridgeInit(&apBridge, AP_MGBA_BRIDGE_PORT);
+		if (!apBridgeReady) {
+			apBridgeRetryFrames = AP_BRIDGE_RETRY_INTERVAL_FRAMES;
+			return;
+		}
+	}
+	APBridgePoll(&apBridge, core);
+	if (APBridgeTakeMessage(&apBridge, messageText, sizeof(messageText))) {
+		struct retro_message message = {
+			.msg = messageText,
+			.frames = 240,
+		};
+		environCallback(RETRO_ENVIRONMENT_SET_MESSAGE, &message);
+	}
+}
 
